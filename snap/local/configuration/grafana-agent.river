logging {
	level = "info"
}

prometheus.exporter.unix "default" {
	// enables more collectors over the default set
	enable_collectors        = ["systemd", "wifi"]
	include_exporter_metrics = true
	disable_collectors       = ["mdadm", "btrfs"]
}

prometheus.scrape "default" {
	targets = concat(
		prometheus.exporter.unix.default.targets,
		[{
			// Self-collect metrics
			job         = "agent",
			__address__ = "127.0.0.1:12345",
		}],
	)

	forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
	external_labels = {
        device_instance = "<device-uid>",
    }
	endpoint {
		url = "<cos-base-url>" + "-prometheus-0/api/v1/write"
	}
}

loki.source.journal "read" {
	forward_to     = [loki.write.endpoint.receiver]
	format_as_json = true
	labels         = {component = "loki.source.journal", instance = "<device-uid>"}
}

loki.write "endpoint" {
	endpoint {
		url = "<cos-base-url>" + "-loki-0/loki/api/v1/push"
	}
}
