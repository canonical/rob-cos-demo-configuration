#!/usr/bin/env python3

import json
import subprocess
import os
import sys

def initialize_defaults():
    """Initialize confdb with default values on first access."""
    # Generate device UID from machine-id
    try:
        with open("/etc/machine-id", "r") as f:
            device_uid = f.read().strip()
    except Exception:
        device_uid = "default-device-id"
    
    # Set default placeholder values
    # These should be updated by the user/administrator after installation
    defaults = {
        "device-uid": device_uid,
        "rob-cos-ip": "rob-cos-ip-placeholder",
        "model-name": "model-name-placeholder",
        "registration-server-endpoint": "-cos-registration-server",
    }
    
    # Set each value
    for key, value in defaults.items():
        cmd = ["snapctl", "set", "--view", ":device-cos-settings-control", f"{key}={value}"]
        subprocess.run(cmd, check=True)
    
    print(f"Initialized confdb with defaults: device-uid={device_uid}")
    return defaults

# Get the current confdb configuration
cmd = "snapctl get --view :device-cos-settings-control -d"
proc = subprocess.run(cmd.split(), capture_output=True, text=True)

if proc.returncode != 0:
    # First access - no data yet, initialize with defaults
    print("First access to confdb, initializing with default values...")
    config = initialize_defaults()
else:
    try:
        config = json.loads(proc.stdout)
        
        # Check if confdb is empty (first run after connection)
        if not config or all(v is None or v == "" for v in config.values()):
            print("Confdb is empty, initializing with default values...")
            config = initialize_defaults()
    except json.JSONDecodeError:
        print("Failed to parse confdb, initializing with default values...")
        config = initialize_defaults()

# Validation
device_uid = config.get("device-uid", "")
rob_cos_ip = config.get("rob-cos-ip", "")
model_name = config.get("model-name", "")

# Validate device UID
if device_uid and len(device_uid) < 3:
    cmd = "snapctl fail Device UID must be at least 3 characters"
    subprocess.run(cmd.split())
    sys.exit(1)

# Validate COS IP format (if provided and not placeholder)
if rob_cos_ip and rob_cos_ip != "rob-cos-ip-placeholder":
    # Basic validation: should look like hostname or IP
    if len(rob_cos_ip) < 1:
        cmd = "snapctl fail COS IP/hostname cannot be empty"
        subprocess.run(cmd.split())
        sys.exit(1)

# Validate model name (if provided and not placeholder)
if model_name and model_name != "model-name-placeholder":
    if len(model_name) < 1:
        cmd = "snapctl fail Model name cannot be empty"
        subprocess.run(cmd.split())
        sys.exit(1)

# Trigger search and replace to update live configuration files with confdb values
# Note: This updates runtime config files in SNAP_COMMON, not the defaults
try:
    search_replace = os.path.join(os.environ.get("SNAP", ""), "usr/bin/search_and_replace.sh")
    if os.path.exists(search_replace):
        subprocess.run(["/bin/bash", search_replace], check=False)
except Exception as e:
    # Don't fail the hook if updates fail - confdb is the source of truth
    print(f"Warning: Could not update configuration files: {e}", file=sys.stderr)

sys.exit(0)
